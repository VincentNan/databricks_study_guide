{
  "datasets": [
    {
      "name": "daily_revenue",
      "displayName": "Daily Revenue Metrics",
      "config": {
        "version": "1.1",
        "source": "lab_uc.gold.daily_revenue",
        "dimensions": [
          {
            "name": "event_date",
            "expr": "event_date"
          },
          {
            "name": "currency",
            "expr": "currency"
          },
          {
            "name": "order_month",
            "expr": "DATE_TRUNC('MONTH', event_date)"
          }
        ],
        "measures": [
          {
            "name": "total_revenue",
            "expr": "SUM(revenue)",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "total_orders",
            "expr": "SUM(orders)"
          },
          {
            "name": "avg_order_value",
            "expr": "MEASURE(`total_revenue`) / MEASURE(`total_orders`)",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          }
        ]
      }
    },
    {
      "name": "product_sales",
      "displayName": "Product Sales Metrics",
      "config": {
        "version": "1.1",
        "source": "lab_uc.gold.study_product_sales",
        "dimensions": [
          {
            "name": "product_id",
            "expr": "product_id"
          }
        ],
        "measures": [
          {
            "name": "total_units_sold",
            "expr": "SUM(units_sold)"
          },
          {
            "name": "total_revenue",
            "expr": "SUM(revenue)",
            "format": {
              "type": "currency",
              "currencyCode": "USD",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          }
        ]
      }
    }
  ],
